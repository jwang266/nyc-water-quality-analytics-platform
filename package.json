{
  "name": "waterqualityapp",
  "version": "1.0.0",
  "description": "Local version of Water Quality Explorer",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:island": "vite --config islands/watersamples/vite.config.ts",
    "build:server": "tsc",
    "build:islands": "vite build --config islands/watersamples/vite.config.ts",
    "build": "npm run build:server && npm run build:islands",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "seed": "node dist/seed.js"
  },
  "keywords": [],
  "author": "jwang266",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "express-session": "^1.18.2",
    "mongoose": "^9.0.0",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.0.10",
    "@types/papaparse": "^5.5.2",
    "@types/passport": "^1.0.17",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
