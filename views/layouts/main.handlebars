<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Water Quality Monitor</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/main.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1"></script>
</head>

<body>
  <header class="site-header">
    <div class="container header-content">
      <h1 class="logo">Water Quality Monitor</h1>

      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/boroughs">Boroughs</a>
        {{#if currentUser}}
        <a href="/users/profile">
          <span class="nav-user">
            Hello, {{#if currentUser.fname}}{{currentUser.fname}}{{else}}{{currentUser.email}}{{/if}}
          </span>
        </a>
        <a href="/users/logout" class="btn btn-outline">Sign Out</a>
        {{else}}
        <a href="/users/login" class="btn btn-outline">Login</a>
        <a href="/users/register" class="btn btn-primary">Sign Up</a>
        {{/if}}
        <button id="themeToggle" class="theme-toggle">Light Mode</button>
      </nav>
    </div>
  </header>

  <main class="page-main">
    {{{body}}}
  </main>

  <!-- Theme Toggle Script -->
  <script>
    const themeToggle = document.getElementById("themeToggle");

    // Load saved theme on refresh
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme === "dark") {
      document.body.classList.add("theme-dark");
      themeToggle.textContent = "Dark Mode";
    } else {
      themeToggle.textContent = "Light Mode";
    }

    themeToggle.addEventListener("click", () => {
      const isDark = document.body.classList.toggle("theme-dark");
      themeToggle.textContent = isDark ? "Dark Mode" : "Light Mode";

      // remember theme
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  </script>

  <footer class="site-footer">
    <div class="container footer-content">
      <p>© 2025 Water Quality Monitor</p>
      <p class="footer-links">
        <a href="https://data.cityofnewyork.us/Environment/Drinking-Water-Quality-Distribution-Monitoring-Dat/bkwf-xfky/about_data"
          target="_blank" rel="noopener noreferrer">
          Source
        </a>
      </p>
    </div>
  </footer>

  <!-- server flash container (used by client toast script) -->
  <div id="server-flash-global" data-error="{{error}}" data-message="{{message}}" data-resend="{{resendLink}}"
    style="display:none"></div>

  <script type="module" src="/js/toast.js"></script>
</body>

</html>