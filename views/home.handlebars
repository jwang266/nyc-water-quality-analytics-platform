<section class="py-10 pb-6">
  <div class="max-w-[1150px] mx-auto px-6">
    <div class="hero-content bg-[var(--surface)] rounded-3xl shadow-[var(--shadow-soft)] px-8 py-8 md:px-10 grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(260px,1.2fr)] gap-8 items-start">
      <div class="hero-text">
        <p class="tagline uppercase tracking-[0.08em] text-xs font-semibold text-[var(--primary-hover)] mb-3">NYC · Drinking Water Dashboard</p>
        <h1 class="m-0 mb-3 text-[2.1rem] font-bold text-[var(--text-main)] leading-tight">Borough Water Quality at a Glance</h1>
        <p class="hero-subtitle m-0 mb-5 text-[var(--text-muted)] leading-relaxed">
          A full-stack web application using Node.js,
          Express, MongoDB, and Handlebars to visualize NYC drinking water quality.
        </p>

        <div class="hero-actions flex flex-wrap gap-3 mb-5">
          <a href="/boroughs" class="btn btn-primary inline-block px-4 py-2 rounded-full text-sm font-semibold bg-[var(--primary)] border border-[var(--primary)] text-white hover:bg-[var(--primary-hover)] no-underline transition-colors">
            View Borough Overview
          </a>
          <a href="/waterSamples" class="btn btn-outline inline-block px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-[var(--surface)] text-[var(--text-main)] hover:border-[var(--primary)] hover:text-[var(--primary)] no-underline transition-colors">
            Browse Water Samples
          </a>
        </div>

        <ul class="hero-highlights list-none p-0 m-0 mb-1.5 flex flex-wrap gap-x-6 gap-y-3 text-sm text-[var(--text-muted)]">
          <li><span class="stat-label font-bold text-[var(--primary-hover)] mr-0.5">5</span> boroughs covered</li>
          <li><span class="stat-label font-bold text-[var(--primary-hover)] mr-0.5">5,000</span> water samples tracked (demo subset)</li>
        </ul>
        <div class="h-4"></div>
        <p class="disclaimer m-0 text-xs text-[var(--text-muted)]">* All data sourced from NYC Open Data.</p>
        <p class="disclaimer m-0 text-xs text-[var(--text-muted)]">* Full dataset supports 160,000+ samples.</p>
      </div>

      <aside class="hero-card bg-[var(--surface-soft)] rounded-2xl border border-[var(--border)] p-5 shadow-[0_10px_26px_rgba(0,0,0,0.08)]">
        <h2 class="mt-0 text-lg font-semibold text-[var(--text-main)]">This Week's Best Borough</h2>
        <ul class="snapshot-list list-none p-0 my-3">
          {{#each boroughSnapshots}}
          <li class="flex justify-between py-1.5 border-b border-dashed border-[var(--border)] text-sm text-[var(--text-muted)] last:border-b-0"><span>{{this.name}}</span><strong class="font-semibold text-[var(--primary)]">{{this.voteCount}} votes</strong></li>
          {{/each}}
        </ul>
        <p class="card-note mt-3 mb-0 text-xs text-[var(--text-muted)]">
          Vote counts this week. Cast your vote to support your favorite borough!
        </p>
        {{#if isAuthenticated}}
        <p class="mt-4 mb-0">
          <a href="/votes/best" class="btn btn-primary inline-block px-4 py-2 rounded-full text-sm font-semibold bg-[var(--primary)] border border-[var(--primary)] text-white hover:bg-[var(--primary-hover)] no-underline transition-colors">Vote</a>
        </p>
        {{else}}
        <p class="mt-4 mb-0">
          <a href="/users/login?redirect=/votes/best" class="btn btn-outline inline-block px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-[var(--surface)] text-[var(--text-main)] hover:border-[var(--primary)] hover:text-[var(--primary)] no-underline transition-colors">Sign in to vote</a>
        </p>
        {{/if}}
      </aside>
    </div>
  </div>
</section>

<section class="info-section pt-5 pb-2">
  <div class="info-grid max-w-[1150px] mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="info-item bg-[var(--surface)] rounded-2xl border border-[var(--border)] px-5 py-4">
      <h3 class="mt-0 mb-1.5 text-[1.05rem] font-semibold text-[var(--text-main)]">Track Borough Trends</h3>
      <p class="m-0 text-sm text-[var(--text-muted)] leading-relaxed">
        View trends of water quality indicators for each borough over the last year.
      </p>
    </div>
    <div class="info-item bg-[var(--surface)] rounded-2xl border border-[var(--border)] px-5 py-4">
      <h3 class="mt-0 mb-1.5 text-[1.05rem] font-semibold text-[var(--text-main)]">Explore Sample Details</h3>
      <p class="m-0 text-sm text-[var(--text-muted)] leading-relaxed">
        Drill into individual samples with detailed measurements and associated boroughs.
      </p>
    </div>
    <div class="info-item bg-[var(--surface)] rounded-2xl border border-[var(--border)] px-5 py-4">
      <h3 class="mt-0 mb-1.5 text-[1.05rem] font-semibold text-[var(--text-main)]">Understand Water Quality</h3>
      <p class="m-0 text-sm text-[var(--text-muted)] leading-relaxed">
        Learn how water quality varies across NYC boroughs and identify areas for improvement.
      </p>
    </div>
  </div>
</section>
