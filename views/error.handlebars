<div class="error-page max-w-lg mx-auto px-4 py-12">
  <div class="bg-[var(--surface)] border border-[var(--border)] rounded-2xl shadow-[var(--shadow-soft)] px-8 py-10 text-center">
    <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-red-500/10 text-red-600 text-2xl font-bold" aria-hidden="true">!</div>

    <h1 class="m-0 mb-4 text-2xl font-bold text-[var(--text-main)]">{{title}}</h1>

    {{#if error}}
      <p class="m-0 mb-6 text-[var(--text-muted)] leading-relaxed">{{error}}</p>
    {{else}}
      <p class="m-0 mb-6 text-[var(--text-muted)] leading-relaxed">An unexpected error occurred.</p>
    {{/if}}

    {{#if link}}
      <a href="{{link}}" class="inline-block px-5 py-2.5 rounded-full text-sm font-semibold bg-[var(--primary)] border border-[var(--primary)] text-white hover:bg-[var(--primary-hover)] no-underline transition-colors">Go back</a>
    {{else}}
      <a href="/" class="inline-block px-5 py-2.5 rounded-full text-sm font-semibold bg-[var(--primary)] border border-[var(--primary)] text-white hover:bg-[var(--primary-hover)] no-underline transition-colors">Go to Home</a>
    {{/if}}
  </div>
</div>
