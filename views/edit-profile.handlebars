<div class="profile-container max-w-[600px] mx-auto my-8 px-4">
  <div class="profile-card bg-[var(--surface)] border border-[var(--border)] rounded-xl p-6 sm:p-8 shadow-[var(--shadow-soft)]">
    <h1 class="mt-0 mb-6 text-3xl font-bold text-[var(--text-main)]">Edit Profile</h1>
    
    {{#if success}}
      <div class="alert alert-success px-4 py-3 mb-5 rounded-md font-medium bg-green-100 text-green-800 border border-green-200">
        {{success}}
      </div>
    {{/if}}

    {{#if error}}
      <div class="alert alert-error px-4 py-3 mb-5 rounded-md font-medium bg-red-100 text-red-800 border border-red-200">
        {{error}}
      </div>
    {{/if}}

    {{#if user}}
      <form method="POST" action="/users/edit-profile" class="form-group flex flex-col">
        <div class="form-field mb-5">
          <label for="fname" class="block mb-2 font-semibold text-[var(--text-main)]">First Name:</label>
          <input 
            type="text" 
            id="fname" 
            name="fname" 
            value="{{user.fname}}"
            required
            placeholder="Enter your first name"
            class="w-full px-3 py-3 border border-[var(--border)] rounded-md text-base bg-[var(--surface-soft)] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--primary)] focus:ring-[3px] focus:ring-[var(--primary)]/10 transition-colors"
          />
        </div>

        <div class="form-field mb-5">
          <label for="lname" class="block mb-2 font-semibold text-[var(--text-main)]">Last Name:</label>
          <input 
            type="text" 
            id="lname" 
            name="lname" 
            value="{{user.lname}}"
            required
            placeholder="Enter your last name"
            class="w-full px-3 py-3 border border-[var(--border)] rounded-md text-base bg-[var(--surface-soft)] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--primary)] focus:ring-[3px] focus:ring-[var(--primary)]/10 transition-colors"
          />
        </div>

        <div class="form-field mb-5">
          <label for="email" class="block mb-2 font-semibold text-[var(--text-main)]">Email:</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="{{user.email}}"
            required
            placeholder="Enter your email"
            class="w-full px-3 py-3 border border-[var(--border)] rounded-md text-base bg-[var(--surface-soft)] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--primary)] focus:ring-[3px] focus:ring-[var(--primary)]/10 transition-colors"
          />
        </div>

        <div class="form-actions flex flex-col sm:flex-row gap-2.5 mt-8">
          <button type="submit" class="btn btn-primary inline-block px-4 py-2 rounded-full text-sm font-semibold bg-[var(--primary)] border border-[var(--primary)] text-white hover:bg-[var(--primary-hover)] cursor-pointer transition-colors sm:flex-1 sm:text-center">Save Changes</button>
          <a href="/users/profile" class="btn btn-outline inline-block px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-[var(--surface)] text-[var(--text-main)] hover:border-[var(--primary)] hover:text-[var(--primary)] no-underline transition-colors sm:flex-1 sm:text-center">Cancel</a>
        </div>
      </form>
    {{else}}
      <div class="profile-section mb-8">
        <p class="text-muted text-[var(--text-muted)]">You are not logged in. Please <a href="/users/login" class="text-[var(--primary)] hover:underline">sign in</a> to edit your profile.</p>
      </div>
    {{/if}}
  </div>
</div>
