<div class="max-w-[1250px] w-full min-h-0 lg:min-h-[680px] bg-[var(--surface)] rounded-[32px] flex flex-col lg:flex-row mx-auto my-5 lg:my-10 shadow-[var(--shadow-soft)] overflow-hidden">

  <div class="w-full lg:w-1/2 overflow-hidden min-h-[220px] sm:min-h-[280px] lg:min-h-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/css/videos/loginSideVideo.mp4" type="video/mp4">
    </video>
  </div>

  <div class="w-full lg:w-1/2 px-6 py-8 sm:px-10 lg:p-[70px] text-[var(--text-main)] bg-[var(--surface)] flex flex-col justify-center">

    <h1 class="text-3xl sm:text-[34px] font-bold mb-1.5 text-[var(--text-main)]">Welcome back</h1>

    <p class="text-[15px] text-[var(--text-muted)] mb-8">
      New here?
      <a href="/users/register" class="text-[var(--primary)] no-underline hover:underline">Create an account</a>
    </p>

    {{#if error}}
    <p class="bg-red-500/10 text-red-600 border border-red-500/25 rounded-lg px-3.5 py-2.5 mb-4 text-sm">{{error}}</p>
    {{/if}}
    {{#if message}}
    <p class="bg-green-500/10 text-green-700 border border-green-500/25 rounded-lg px-3.5 py-2.5 mb-4 text-sm">{{message}}</p>
    {{/if}}
    {{#if resendLink}}
    <p class="text-sm text-[var(--text-muted)] mb-4">Please verify your email. <a href="{{resendLink}}" class="text-[var(--primary)] hover:underline">Resend verification</a></p>
    {{/if}}

    <form method="POST" action="/users/login" class="flex flex-col">
      {{!-- redirect route key --}}
      <input type="hidden" name="redirect" value="{{redirect}}">

      <input type="email" name="email" placeholder="Email" required
        class="w-full bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">

      <input type="password" name="password" placeholder="Enter your password" required
        class="w-full mt-3.5 bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">

      <button type="submit"
        class="w-full h-12 mt-4 bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white font-semibold rounded-lg text-base border-0 cursor-pointer transition-colors">
        Log in
      </button>
    </form>

    {{!-- Google OAuth buttons removed --}}

  </div>

</div>
