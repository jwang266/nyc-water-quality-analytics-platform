<div class="max-w-[1250px] w-full min-h-0 lg:min-h-[680px] bg-[var(--surface)] rounded-[32px] flex flex-col lg:flex-row mx-auto my-5 lg:my-10 shadow-[var(--shadow-soft)] overflow-hidden">

  <div class="w-full lg:w-1/2 overflow-hidden min-h-[220px] sm:min-h-[280px] lg:min-h-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/css/videos/loginSideVideo.mp4" type="video/mp4">
    </video>
  </div>

  <div class="w-full lg:w-1/2 px-6 py-8 sm:px-10 lg:p-[70px] text-[var(--text-main)] bg-[var(--surface)] flex flex-col justify-center">

    <h1 class="text-3xl sm:text-[34px] font-bold mb-1.5 text-[var(--text-main)]">Create an account</h1>

    <p class="text-[15px] text-[var(--text-muted)] mb-8">
      Already have an account?
      <a href="/users/login" class="text-[var(--primary)] no-underline hover:underline">Log in</a>
    </p>

    {{#if error}}
    <p class="bg-red-500/10 text-red-600 border border-red-500/25 rounded-lg px-3.5 py-2.5 mb-4 text-sm">{{error}}</p>
    {{/if}}
    {{#if message}}
    <p class="bg-green-500/10 text-green-700 border border-green-500/25 rounded-lg px-3.5 py-2.5 mb-4 text-sm">{{message}}</p>
    {{#if loginLink}}
    <p class="mb-4"><a href="{{loginLink}}" class="inline-block px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-[var(--surface)] text-[var(--text-main)] hover:border-[var(--primary)] hover:text-[var(--primary)] no-underline transition-colors">Go to Login</a></p>
    {{/if}}
    {{#if resendLink}}
    <p class="mb-4"><a href="{{resendLink}}" class="inline-block px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-[var(--surface)] text-[var(--text-main)] hover:border-[var(--primary)] hover:text-[var(--primary)] no-underline transition-colors">Resend verification</a></p>
    {{/if}}
    {{/if}}
    {{#if verifyUrl}}
    <p class="text-sm text-[var(--text-muted)] mb-4 break-all">Verification link (dev): <a href="{{verifyUrl}}" class="text-[var(--primary)] hover:underline">{{verifyUrl}}</a></p>
    {{/if}}

    <form method="POST" action="/users/register" class="flex flex-col">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <input type="text" name="fname" placeholder="First name" required
          class="w-full bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">
        <input type="text" name="lname" placeholder="Last name" required
          class="w-full bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">
      </div>

      <input type="email" name="email" placeholder="Email" required
        class="w-full mt-3.5 bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">

      <input type="password" name="password" placeholder="Enter your password" required
        class="w-full mt-3.5 bg-[var(--surface-soft)] border border-[var(--border)] rounded-lg px-3.5 py-3.5 text-[15px] text-[var(--text-main)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/20 focus:border-[var(--primary)]">

      <label class="terms inline-flex items-center gap-2 mt-3 text-sm text-[var(--text-muted)]">
        <input type="checkbox" required class="w-auto shrink-0">
        I agree to the <a href="#!" id="showTerms" class="text-[var(--primary)] hover:underline ml-0.5">Terms & Conditions</a>
      </label>

      <button
        class="w-full h-12 mt-4 bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white font-semibold rounded-lg text-base border-0 cursor-pointer transition-colors">
        Create account
      </button>
    </form>

    <div id="termsModal" class="modal hidden fixed inset-0 z-[1000] bg-black/50 flex justify-center items-center p-4">
      <div class="modal-content relative bg-white rounded-lg p-8 max-w-[600px] w-[90%] shadow-xl">
        <span id="closeTerms" class="close absolute top-4 right-4 cursor-pointer text-2xl leading-none text-gray-500 hover:text-gray-800">&times;</span>
        <h2 class="text-center text-black text-xl font-bold mb-4">Terms & Conditions</h2>
        <p class="text-left text-gray-700 mb-3">This is the GitHub jwang266 local version project for educational purposes
          only.</p>
        <p class="text-left text-gray-700">All functionality is provided for learning and academic use.</p>
      </div>
    </div>

  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('termsModal');
    const showBtn = document.getElementById('showTerms');
    const closeBtn = document.getElementById('closeTerms');

    showBtn.addEventListener('click', e => {
      e.preventDefault();
      modal.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
    modal.addEventListener('click', e => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  });
</script>
